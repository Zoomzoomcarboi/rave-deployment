#!/bin/sh
set -eu

rootfs_input=${1:?missing target rootfs}
rootfs=$(realpath -e -- "$rootfs_input")
test -n "$rootfs"
test "$rootfs" != "/"
test -d "$rootfs/etc"
test -d "$rootfs/opt"

source_root=${SRCROOT:?missing rpi-image-gen source root}
repository_root=$(realpath -e -- "$source_root/..")
test -d "$repository_root/setup-ui/rave_web"
test -f "$repository_root/systemd/rave-webd.service"
test -f "$repository_root/THIRD_PARTY_NOTICES.md"

install -d -m 0755 \
  "$rootfs/opt/rave/web/rave_web" \
  "$rootfs/usr/lib/systemd/system" \
  "$rootfs/usr/share/doc/rave-web"
rsync -a --delete --exclude='__pycache__' --exclude='*.pyc' \
  "$repository_root/setup-ui/rave_web/" "$rootfs/opt/rave/web/rave_web/"
find "$rootfs/opt/rave/web/rave_web" -type d -exec chmod 0755 {} +
find "$rootfs/opt/rave/web/rave_web" -type f -exec chmod 0644 {} +
install -m 0644 "$repository_root/systemd/rave-webd.service" \
  "$rootfs/usr/lib/systemd/system/rave-webd.service"
install -m 0644 "$repository_root/THIRD_PARTY_NOTICES.md" \
  "$rootfs/usr/share/doc/rave-web/THIRD_PARTY_NOTICES.md"
