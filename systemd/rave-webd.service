[Unit]
Description=RAVE local management web service
Requires=rave-wifi-init.service
Wants=network-online.target
After=network-online.target NetworkManager-wait-online.service rave-wifi-init.service

[Service]
Type=simple
User=rave
Group=rave
Environment=RAVE_PROVIDER=pi
ExecStart=/usr/bin/python3 -m uvicorn rave_web.app:app --app-dir /opt/rave/web --host 192.168.77.1 --port 8080 --no-access-log
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
