[Unit]
Description=RAVE Edge placeholder (production runtime not implemented)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/rave/rave.toml

[Service]
Type=simple
User=rave
Group=rave
ExecStart=/usr/bin/rave-edge --config /etc/rave/rave.toml
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rave /var/log/rave
